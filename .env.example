# ─────────────────────────────────────────────────────────────────────────────
# IBM Watsonx.ai Credentials
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

IBM_API_KEY=your_ibm_cloud_api_key_here
IBM_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSONX_URL=https://au-syd.ml.cloud.ibm.com

# Flask Configuration
FLASK_SECRET_KEY=change_this_to_a_random_secret_string
FLASK_ENV=development
FLASK_PORT=5000

# Model Configuration
# Available instruct models on au-syd region:
#   meta-llama/llama-3-3-70b-instruct  (best for chat — recommended)
#   meta-llama/llama-3-1-8b            (faster, lighter)
#   ibm/granite-3-1-8b-base            (IBM base model)
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct
